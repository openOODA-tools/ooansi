// # ooansi Options - Command Line Flags and Operational Configuration
//
// Logline: Decodes command line arguments into ANSI generator modes.
//
// Setup: Pure value type and parser. Zero ambient authority.
//
// Beats:
//   1. Define AnsiOpts struct holding action mode, parameters, and flags.
//   2. Provide safe default initializer.
//   3. Parse argument vector into validated AnsiOpts model.

pub type AnsiOpts = struct {
    action: String,
    arg1: String,
    arg2: String,
    arg3: String,
    json_mode: Bool,
    mcp_mode: Bool,
    help_mode: Bool,
    version_mode: Bool,
    error_msg: String
};

pub fn ansi_opts_default() -> AnsiOpts {
    return AnsiOpts {
        action: "",
        arg1: "",
        arg2: "",
        arg3: "",
        json_mode: false,
        mcp_mode: false,
        help_mode: false,
        version_mode: false,
        error_msg: ""
    };
}

pub fn parse_ansi_args(args: List[String]) -> AnsiOpts {
    let mut opts: AnsiOpts = ansi_opts_default();
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            opts.help_mode = true;
            return opts;
        } else if arg == "-v" || arg == "--version" {
            opts.version_mode = true;
            return opts;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
        } else if arg == "--json" {
            opts.json_mode = true;
        } else if opts.action == "" && !str_starts_with(arg, "-") {
            opts.action = arg;
        } else if opts.arg1 == "" && !str_starts_with(arg, "-") {
            opts.arg1 = arg;
        } else if opts.arg2 == "" && !str_starts_with(arg, "-") {
            opts.arg2 = arg;
        } else if opts.arg3 == "" && !str_starts_with(arg, "-") {
            opts.arg3 = arg;
        }
        i = i + 1;
    }
    return opts;
}
